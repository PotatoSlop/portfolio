---
// Shared HTML shell. The skeleton (anchor, breadcrumbs, tokens) gets built out
// in Phase 3; for now it just wires the document + View Transitions.
import { ClientRouter } from 'astro:transitions';

// Migration Step 1: reuse the existing modular stylesheet as-is, kept global.
// styles/ stays at the repo root (single source of truth); the bundler inlines
// its @import chain. No CSS rewrite — this is a faithful carry-over.
import '../../styles/main.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Dylan Chen', description = 'Dylan Chen — portfolio' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    {/* Fonts — same providers the original site used (Google Nunito + Adobe Typekit) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://use.typekit.net/nnb5nol.css" />

    {/* Astro View Transitions (ClientRouter) — powers the sketch→render cross-fades */}
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
