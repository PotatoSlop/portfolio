---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Scrollbar from '../components/Scrollbar.astro';
import SettingsToggles from '../components/SettingsToggles.astro';
import '../../styles/main.css';

interface Props {
  title?: string;
  description?: string;
  showFooter?: boolean;
  theme?: 'sketchbook' | 'engineering' | 'design' | 'software';
}

const {
  title = 'Dylan Chen',
  description = 'Dylan Chen — portfolio',
  showFooter = true,
  theme = 'sketchbook',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    {/* Colour scheme — set BEFORE first paint to avoid a light→dark flash.
        Runs synchronously (is:inline, not deferred/bundled): reads the stored
        choice, else the OS preference, and stamps data-scheme on <html>. The
        stored key + apply logic are mirrored in SettingsToggles.astro (toggle)
        and below (SPA-nav persistence). */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('color-scheme');
          // Default to LIGHT for first-time visitors (style choice), regardless of the
          // OS preference. An explicit stored choice still wins, so anyone who toggles
          // to dark keeps it.
          var dark = stored ? stored === 'dark' : false;
          if (dark) document.documentElement.dataset.scheme = 'dark';
          else delete document.documentElement.dataset.scheme;
        } catch (e) {}
      })();
    </script>


    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Dela+Gothic+One&family=IBM+Plex+Sans:wght@300;400;500;700&family=JetBrains+Mono:wght@400;700&family=Nunito:wght@400;800&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://use.typekit.net/nnb5nol.css" />

    <ClientRouter />
  </head>
  <body>
    <div id="nav-curtain" class="nav-curtain" transition:persist aria-hidden="true">
      <span class="nav-curtain__label"></span>
    </div>

    <style>
      * {
        -webkit-tap-highlight-color: transparent;
      }

      .nav-curtain {
        position: fixed;
        inset: 0;
        z-index: 3000; /* above all page chrome (nav, scrollbar, tabs) while covering */
        display: grid;
        place-items: center; /* label centred on the viewport midline, like the door */
        background: var(--curtain-bg, transparent);
        color: var(--curtain-ink, currentColor);
        opacity: 0; /* idle: invisible */
        pointer-events: none; /* purely visual — never intercepts input */
      }
      /* Armed by PullTabs at the moment the door has covered the screen. */
      .nav-curtain.is-covering {
        opacity: 1;
      }
      /* Revealed by Base once the new page has mounted behind it. */
      .nav-curtain.is-covering.is-lifting {
        transition: opacity 0.4s var(--ease-smooth, ease);
        opacity: 0;
      }
      .nav-curtain__label {
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: clamp(3rem, 12vw, 12rem);
        letter-spacing: -0.02em;
        line-height: normal;
      }
      @media (prefers-reduced-motion: reduce) {
        .nav-curtain.is-covering.is-lifting {
          transition: none;
        }
      }
    </style>

    <Nav theme={theme} />
    <Scrollbar />
    <slot />
    <SettingsToggles />
    {/* Contact page opts out — a "Get in Touch" footer CTA there is circular. */}
    {showFooter && <Footer />}

    <script>
      // Freeze animated GIFs (the waving doodle, the boiling-name logo) at frame
      // zero under reduced motion — swaps to a static still, restores on toggle.
      import { mountFreezeGifs } from '../lib/motion/freeze-gifs';
      mountFreezeGifs();
    </script>

    <script>
      import { inView } from 'motion';
      import { onPageReady } from '../lib/motion/lifecycle';

      // onPageReady runs this on every page that has a footer (and adds the
      // first-SPA-entry catch-up), returning a teardown that stops the observer and
      // undoes the nav-theme vars on navigation away. Without that teardown each
      // navigation added another footer observer (leak) and — because inView's
      // stop() does NOT fire the leave callback — navigating away while the footer
      // was in view left the footer nav colors stuck on the next page.
      onPageReady('.contact-footer', () => {
        const footer = document.querySelector('.contact-footer') as HTMLElement | null;
        const cursorEffect = document.querySelector('.cursor-effects') as HTMLElement | null;
        const root = document.documentElement;
        if (!footer || !cursorEffect) return;

        // Footer cursor blob — follows the pointer while hovering the footer. These
        // listeners are on the footer node, which is discarded on the next swap, so
        // they don't leak and need no explicit removal.
        footer.addEventListener('mouseenter', () => {
          cursorEffect.style.opacity = '1';
          cursorEffect.style.transform = 'scale(1)';
        });
        footer.addEventListener('mouseleave', () => {
          cursorEffect.style.opacity = '0';
          cursorEffect.style.transform = 'scale(0)';
        });
        footer.addEventListener('mousemove', (e: MouseEvent) => {
          const rect = footer.getBoundingClientRect();
          const cursorWidth = cursorEffect.offsetWidth;
          const cursorHeight = cursorEffect.offsetHeight;
          cursorEffect.style.left = e.clientX - rect.left - cursorWidth / 2 + 'px';
          cursorEffect.style.top = e.clientY - rect.top - cursorHeight / 2 + 'px';
        });

        // Recolor the nav theme tokens once the footer scrolls into view.
        const defaultTheme: Record<string, string> = {
          '--nav-link-bg': 'transparent',
          '--nav-hover-fill': '#F5A045',
          '--hamburger-hover-bg': '#F5A045',
        };
        const footerTheme: Record<string, string> = {
          '--nav-link-bg': '#F5A045',
          '--nav-hover-fill': '#fff',
          '--hamburger-hover-bg': '#fff',
        };
        const applyNavTheme = (theme: Record<string, string>) => {
          for (const [key, value] of Object.entries(theme)) {
            root.style.setProperty(key, value);
          }
        };
        // Recolor while the footer is in view; restore on leave. Not a tween —
        // a two-way token toggle — so we use inView's enter/leave callbacks
        // directly rather than reveal().
        const stopFooterInView = inView(
          footer,
          () => {
            applyNavTheme(footerTheme);
            return () => applyNavTheme(defaultTheme);
          },
          { margin: '0px 0px -95% 0px' }
        );

        return () => {
          stopFooterInView();
          applyNavTheme(defaultTheme); // stop() won't fire the leave cb — undo ourselves
        };
      });
    </script>

    <script>
      import { navigate } from 'astro:transitions/client';

      const DISCIPLINE_ORDER = ['/engineering', '/design', '/software'];
      const normalize = (p: string) => (p.replace(/\/$/, '') || '/');
      const indexOfRoute = (p: string) => DISCIPLINE_ORDER.indexOf(normalize(p));

      // Colour scheme is a client-only preference (never rendered server-side),
      // so the incoming document arrives without it. Copy the current scheme onto
      // the new <html> before the swap paints — otherwise every navigation flashes
      // back to the base (light) scheme. Mirrors the FOUC-safe head script.
      document.addEventListener('astro:before-swap', (e) => {
        const current = document.documentElement.dataset.scheme;
        if (current) e.newDocument.documentElement.dataset.scheme = current;
        else delete e.newDocument.documentElement.dataset.scheme;
      });

      document.addEventListener('astro:before-swap', (e) => {
        const root = e.newDocument.documentElement;

        if (document.documentElement.dataset.doorNav) {
          delete document.documentElement.dataset.doorNav;
          root.removeAttribute('data-slide');
          return;
        }
        const fromIdx = indexOfRoute(e.from.pathname);
        const toIdx = indexOfRoute(e.to.pathname);
        if (fromIdx === -1 || toIdx === -1 || fromIdx === toIdx) {
          root.removeAttribute('data-slide'); // non-sibling → default fade
          return;
        }
        // Every discipline hop reads as "pulling the next page in from the
        // right", so the new page always enters right-to-left — never the
        // reverse, regardless of list order.
        root.setAttribute('data-slide', 'forward');
      });


      // eslint-disable-next-line no-restricted-syntax -- bound-once global reset of the transition:persist nav curtain, not page content (docs/routing-and-lifecycle.md §3.5)
      document.addEventListener('astro:page-load', () => {
        const curtain = document.getElementById('nav-curtain');
        if (!curtain || !curtain.classList.contains('is-covering')) return;
        const reset = () => curtain.classList.remove('is-covering', 'is-lifting');
        // Next frame so the browser has painted the covering state before the
        // opacity transition starts (otherwise it can be skipped).
        requestAnimationFrame(() => curtain.classList.add('is-lifting'));
        curtain.addEventListener(
          'transitionend',
          (ev) => {
            if (ev.propertyName === 'opacity') reset();
          },
          { once: true }
        );
        // Fallback so the classes always clear (reduced-motion = no transition =
        // no transitionend; or an interrupted transition).
        window.setTimeout(reset, 700);
      });

      // ----- Swipe / drag to the neighbouring discipline -----
      const SWIPE_THRESHOLD = 70; // px of horizontal travel to commit
      let startX = 0;
      let startY = 0;
      let tracking = false;

      const onDiscipline = () => indexOfRoute(window.location.pathname) !== -1;

      const goNeighbour = (dir: 1 | -1) => {
        const idx = indexOfRoute(window.location.pathname);
        if (idx === -1) return;
        const target = DISCIPLINE_ORDER[(idx + dir + DISCIPLINE_ORDER.length) % DISCIPLINE_ORDER.length];
        navigate(target);
      };

      const beginSwipe = (x: number, y: number) => {
        if (!onDiscipline()) return;
        startX = x;
        startY = y;
        tracking = true;
      };
      const endSwipe = (x: number, y: number) => {
        if (!tracking) return;
        tracking = false;
        const dx = x - startX;
        const dy = y - startY;
        // Require a dominant horizontal gesture so vertical scrolls don't trigger.
        if (Math.abs(dx) < SWIPE_THRESHOLD || Math.abs(dx) < Math.abs(dy) * 1.5) return;
        goNeighbour(dx < 0 ? 1 : -1); // swipe left → next (forward), right → prev
      };

      // TOUCH ONLY (mobile). Desktop uses the pull-tab door handles, not a
      // free-swipe, so there's no pointer/mouse drag-to-navigate here.
      document.addEventListener(
        'touchstart',
        (e) => beginSwipe(e.changedTouches[0].clientX, e.changedTouches[0].clientY),
        { passive: true }
      );
      document.addEventListener(
        'touchend',
        (e) => endSwipe(e.changedTouches[0].clientX, e.changedTouches[0].clientY),
        { passive: true }
      );
    </script>

  </body>
</html>
