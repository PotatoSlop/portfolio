---
import Base from '../layouts/Base.astro';
import PullTabs from '../components/PullTabs.astro';
import DotLines from '../components/DotLines.astro';
import Wordmark from '../components/Wordmark.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import ProjectAccordion from '../components/projects/ProjectAccordion.astro';
import CaseOverlay from '../components/projects/CaseOverlay.astro';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const CURRENT = 'engineering' as const;

const tagged = await getCollection('projects', ({ data }) => data.disciplines.includes(CURRENT));
const projects = tagged.sort((a, b) => a.data.order - b.data.order);

// The hero keeps its own full-bleed feature block; the accordion holds the rest.
const featured = projects.find((p) => p.data.hero) ?? projects[0] ?? null;
const rest = projects.filter((p) => p !== featured);
---

<Base title="Engineering — Dylan Chen" theme="engineering">
  <main class="eng">
    <section class="eng-hero">
      <div class="eng-reveal eng-reveal--crumbs">
        <nav class="eng-hero__crumbs" aria-label="Breadcrumb">
          <a href="/">SKETCHBOOK</a> / <a href="/engineering" aria-current="page">ENGINEERING</a>
        </nav>
      </div>

      <h1 class="eng-hero__title"><Wordmark /></h1>

      <span class="eng-reveal eng-reveal--cta">
        <a class="eng-hero__cta" href="#eng-gallery">SEE PROJECTS</a>
      </span>

      <a class="eng-chevron" href="#eng-gallery" aria-label="Scroll to projects">
        <span class="eng-chevron__crop">
          <Icon name="mdi:chevron-down">
        </span>
        <span class="eng-chevron__text">Scroll to Projects</span>
      </a>
    </section>

    <section id="eng-gallery" class="eng-gallery" aria-label="Engineering projects">
      <div class="wrap">
        {
          featured && (
            <div class="eng-feature-crop">
              <ProjectCard project={featured} current={CURRENT} variant="feature" />
            </div>
          )
        }

        <ProjectAccordion projects={rest} current={CURRENT} />
      </div>
    </section>
  </main>

  <CaseOverlay />
  <PullTabs discipline="engineering" />
  <DotLines />
  <div class="eng-grid-reveal" aria-hidden="true"></div>

  <style>
    * {
      -webkit-user-select: none;
      -webkit-user-drag: none;
    }

    .eng {
      position: relative;
    }
    .eng-grid-reveal {
      position: fixed;
      inset: 0;
      z-index: -1;
      background: var(--theme-bg);
      pointer-events: none;
    }
    @media (prefers-reduced-motion: reduce) {
      .eng-grid-reveal { display: none; }
    }
    @property --eng-ripple {
      syntax: '<percentage>';
      inherits: false;
      initial-value: 0%;
    }

    .eng-hero {
      position: relative;
      min-height: calc(105dvh - clamp(60px, 10vh, 80px));
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      padding: 15vh clamp(1rem, 3vw, 2rem) 0 clamp(1rem, 3vw, 2rem);
    }

    .eng-reveal {
      display: block;
      width: fit-content;
      overflow: hidden;
    }

    .eng-reveal--crumbs {
      position: relative;
      z-index: 10;
      margin: -10vh 0 -3vh -2.2rem;
    }

    .eng-hero__title {
      margin: 0;
      width: 100%;
    }

    .eng-reveal--cta {
      margin: -3vh 0 0 -2.2rem;
    }

    .eng-hero__crumbs {
      display: flex;
      width: fit-content;
      align-items: left;
      gap: 0.4em;
      padding: 0.5em 1em;
      background: var(--color-black);
      font-family: var(--theme-font-body);
      font-style: normal;
      font-size: 16px;
      color: var(--color-white);
      z-index: 10;
    }
    .eng-hero__crumbs a {
      color: inherit;
      text-decoration: none;
      z-index: 10;
    }
    .eng-hero__crumbs a:hover {
      color: var(--theme-accent);
    }

    .eng-hero__cta {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      display: inline-block;
      padding: 0.5rem 1rem;
      background: var(--color-black);
      color: var(--color-white);
      font-family: var(--theme-font-body);
      font-weight: 500;
      font-size: 18px;
      letter-spacing: 0.04em;
      text-decoration: none;
      transition: color var(--duration-fast) var(--theme-motion-ease);
    }
    .eng-hero__cta::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background: var(--theme-accent);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.6s var(--theme-motion-ease);
    }
    .eng-hero__cta:hover,
    .eng-hero__cta:focus-visible {
      color: var(--color-black);
      outline: none;
    }
    .eng-hero__cta:hover::before,
    .eng-hero__cta:focus-visible::before {
      transform: scaleX(1);
    }

    .eng-chevron {
      position: absolute;
      bottom: clamp(1rem, 3vh, 2rem);
      left: 0;
      right: 0;
      width: fit-content;
      margin-inline: auto;
      display: grid;
      place-items: center;
      padding: 0.5rem;
      color: var(--theme-ink);
      transition: transform var(--duration-fast) var(--theme-motion-ease);
    }
    .eng-chevron:hover,
    .eng-chevron:focus-visible {
      transform: scale(1.12);
      outline: none;
    }
    .eng-chevron__crop {
      display: block;
      overflow: hidden;
      line-height: 0;
    }
    .eng-chevron svg {
      width: clamp(28px, 4vw, 40px);
      height: clamp(28px, 4vw, 40px);
      display: block;
    }

    /* The projects gallery: a centred column (.wrap) with tight cinematic
       gutters. The card system itself lives in styles/components/project-card.css. */
    .eng-gallery {
      padding: 0 clamp(0.5rem, 1.5vw, 1rem) clamp(2rem, 6vh, 4rem);
    }
    /* Crop container for the hero reveal: overflow-clips the feature card while
       reveal.ts rides it up from translateY(100%). Observe THIS (stationary) and
       animate the child .feat — the motion-migration IntersectionObserver rule. */
    .eng-feature-crop {
      overflow: hidden;
      line-height: 0;
      /* Subtle lift off the page (shared token from .wrap). The crop's own
         shadow isn't clipped by its overflow — only its children are. */
      box-shadow: var(--card-shadow);
    }

    @media (max-width: 768px) {
      .eng-reveal--crumbs {
        display: none;
      }
      .eng-hero {
        padding-top: clamp(3rem, 12vh, 6rem);
      }
      .eng-reveal--cta {
        margin: 2vh 0 0 0;
      }
    }

    /* Small tablets / large phones. */
    @media (max-width: 700px) {
      .eng-hero {
        padding-inline: 1.25rem;
        padding-bottom: 0;
      }
    }

    @media (max-width: 400px) {
      .eng-hero {
        padding-inline: 0;
        align-items: center;
        text-align: center;
      }
      .eng-hero__title {
        display: flex;
        justify-content: center;
      }
      .eng-reveal--cta {
        width: 100%;
        margin: 3vh 0 0 0;
        display: flex;
        justify-content: center;
      }
      .eng-hero__cta {
        font-size: 20.5px;
        padding: 0.75rem 1.25rem;
      }
    }

    @keyframes cropRise {
      from { transform: translateY(110%); }
      to   { transform: translateY(0); }
    }
    @keyframes gridRipple {
      from { --eng-ripple: 0%; }
      to   { --eng-ripple: 140%; }
    }
    @keyframes gridRippleSafety {
      to { opacity: 0; }
    }

    @media (prefers-reduced-motion: no-preference) {
      .eng-reveal--crumbs > .eng-hero__crumbs {
        animation: cropRise 0.5s var(--ease-smooth) 0.05s backwards;
      }
      .eng-reveal--cta > .eng-hero__cta {
        animation: cropRise 0.5s var(--ease-smooth) var(--eng-intro-after) backwards;
      }
      .eng-chevron svg {
        animation:
          cropRise 0.5s var(--ease-smooth)
            calc(var(--eng-intro-after) + var(--eng-intro-step)) backwards,
          wave 2s ease-in-out
            calc(var(--eng-intro-after) + var(--eng-intro-step) + 0.5s) infinite;
      }
      .eng-grid-reveal {
        -webkit-mask-image: radial-gradient(
          circle at 50% 42%,
          transparent var(--eng-ripple, 0%),
          #000 calc(var(--eng-ripple, 0%) + 1.5%)
        );
        mask-image: radial-gradient(
          circle at 50% 42%,
          transparent var(--eng-ripple, 0%),
          #000 calc(var(--eng-ripple, 0%) + 1.5%)
        );
        animation:
          gridRipple 2.3s linear 0.05s forwards,
          gridRippleSafety 0.3s linear 2s forwards;
      }
    }
  </style>

  <script>
    import { reveal } from '../lib/motion/reveal';
    import { eases } from '../lib/motion/tokens';
    import { mountVideoScrub, type VideoScrubHandle } from '../lib/motion/video-scrub';
    import { mountChipTrail } from '../lib/motion/pointer-follow';
    import { mountCaseOverlay } from '../lib/motion/case-overlay';

    let videoScrub: VideoScrubHandle | null = null;
    let destroyChip: (() => void) | null = null;
    let destroyOverlay: (() => void) | null = null;

    document.addEventListener('astro:page-load', () => {
      // Hero feature rides up from below its crop on first scroll into view.
      reveal(
        '.eng-feature-crop .feat',
        {
          transform: ['translateY(100%)', 'translateY(0)'],
          opacity: [0.25, 1],
        },
        {
          observe: '.eng-feature-crop',
          delay: 0.05,
          duration: 0.8,
          ease: eases.smooth,
          amount: 0.2,
          margin: '0px 0px -8% 0px',
        }
      );

      // Hover-scrubbed hero clip: the whole feature card drives playback.
      const feature = document.querySelector<HTMLElement>('.feat');
      const video = feature?.querySelector<HTMLVideoElement>('[data-scrub-video]');
      if (feature && video) {
        videoScrub = mountVideoScrub(feature, video);
      }

      // Trailing "View Project" chip + SPA case-study overlay.
      destroyChip = mountChipTrail();
      destroyOverlay = mountCaseOverlay();
    });

    document.addEventListener('astro:before-swap', () => {
      videoScrub?.destroy();
      videoScrub = null;
      destroyChip?.();
      destroyChip = null;
      destroyOverlay?.();
      destroyOverlay = null;
    });
  </script>
</Base>
