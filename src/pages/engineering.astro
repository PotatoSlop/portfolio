---
/*
  /engineering — composed from the shared EngineeringPage body (landing →
  featured → dial index) plus the site chrome every discipline page carries.
  Featured selection + timeline order live in src/lib/projects/timeline.ts.
*/
import Base from '../layouts/Base.astro';
import PullTabs from '../components/PullTabs.astro';
import DotLines from '../components/DotLines.astro';
import EngineeringPage from '../components/engineering/EngineeringPage.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', ({ data }) => data.disciplines.includes('engineering'));
---

<Base title="Engineering — Dylan Chen" theme="engineering">
  <EngineeringPage projects={projects} />
  <PullTabs discipline="engineering" />
  <DotLines />
</Base>
