---
// Shared discipline-page skeleton (Step D). IDENTICAL across the three
// disciplines — only theme tokens (data-theme on <html>) and the interaction
// idiom (data-idiom on the grid) change. Renders a breadcrumb, a hero, a grid
// queried from the content collection, and the cross-discipline sibling rail.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SiblingRail from './SiblingRail.astro';

type Discipline = 'engineering' | 'design' | 'software';
interface Props {
  discipline: Discipline;
  tagline?: string;
}
const { discipline, tagline } = Astro.props;

// Per-discipline interaction idiom flag. Engineering's "dimension" idiom is
// built out below as the reference; design/software carry their flag so the
// SAME card component can grow their idioms later without a skeleton change.
const IDIOM: Record<Discipline, string> = {
  engineering: 'dimension',
  design: 'reveal',
  software: 'caret',
};

const label = discipline.charAt(0).toUpperCase() + discipline.slice(1);

// Multi-discipline projects surface in every grid they're tagged with.
const tagged = await getCollection('projects', ({ data }) =>
  data.disciplines.includes(discipline)
);
const sorted = tagged.sort((a, b) => a.data.order - b.data.order);
const hero = sorted.find((p) => p.data.hero) ?? sorted[0];
const grid = sorted.filter((p) => p.id !== hero?.id);

const outboundHref = (p: (typeof sorted)[number]) =>
  p.data.links?.live ?? p.data.links?.repo ?? p.data.links?.download ?? null;
---

<main class="disc" data-discipline={discipline}>
  <nav class="disc__crumbs" aria-label="Breadcrumb">
    <a href="/">Sketchbook</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{label}</span>
  </nav>

  <header class="disc__head">
    <h1 class="disc__title">{label}</h1>
    {tagline && <p class="disc__tagline">{tagline}</p>}
  </header>

  {
    hero && (
      <a
        class="disc__hero"
        href={outboundHref(hero) ?? undefined}
        target={outboundHref(hero) ? '_blank' : undefined}
        rel={outboundHref(hero) ? 'noopener noreferrer' : undefined}
      >
        <div class="disc__hero-media">
          {hero.data.cover ? (
            <Image
              src={hero.data.cover}
              alt=""
              format="webp"
              loading="eager"
              style={`--cover-x:${hero.data.coverX}px;--cover-y:${hero.data.coverY}px;--cover-scale:${hero.data.coverScale}`}
            />
          ) : (
            <span class="disc__placeholder" aria-hidden="true">
              {hero.data.title.charAt(0)}
            </span>
          )}
        </div>
        <div class="disc__hero-body">
          <span class="disc__eyebrow">
            {hero.data.status === 'wip' ? 'In progress' : 'Featured'} · Hero
          </span>
          <h2>{hero.data.title}</h2>
          {hero.data.overview && <p>{hero.data.overview}</p>}
          {hero.data.subTags.length > 0 && (
            <ul class="disc__tags">
              {hero.data.subTags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )}
        </div>
      </a>
    )
  }

  {
    grid.length > 0 && (
      <ul class="disc__grid" data-idiom={IDIOM[discipline]}>
        {grid.map((p, i) => {
          const href = outboundHref(p);
          return (
            <li class="disc-card">
              {href ? (
                <a
                  class="disc-card__link"
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                />
              ) : null}
              <span class="disc-card__index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="disc-card__media">
                {p.data.cover ? (
                  <Image
                    src={p.data.cover}
                    alt=""
                    format="webp"
                    style={`--cover-x:${p.data.coverX}px;--cover-y:${p.data.coverY}px;--cover-scale:${p.data.coverScale}`}
                  />
                ) : (
                  <span class="disc__placeholder" aria-hidden="true">
                    {p.data.title.charAt(0)}
                  </span>
                )}
              </div>
              <div class="disc-card__body">
                <h3 class="disc-card__title">{p.data.title}</h3>
                {p.data.overview && <p class="disc-card__desc">{p.data.overview}</p>}
                {p.data.subTags.length > 0 && (
                  <ul class="disc__tags">
                    {p.data.subTags.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                )}
              </div>
              {/* Engineering dimension-callout idiom decoration (hover-revealed) */}
              <span class="disc-card__dim" aria-hidden="true" />
            </li>
          );
        })}
      </ul>
    )
  }

  {
    sorted.length === 0 && (
      <p class="disc__empty">
        No {label.toLowerCase()} projects published yet — they land as the
        content collection fills out.
      </p>
    )
  }

  <SiblingRail discipline={discipline} />
</main>

<style>
  .disc {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(1.5rem, 5vw, 3rem) clamp(1rem, 4vw, 2.5rem) clamp(2rem, 6vw, 4rem);
    color: var(--theme-ink);
  }

  .disc__crumbs {
    display: flex;
    gap: 0.5em;
    align-items: center;
    font-family: var(--theme-font-body);
    font-size: 0.85rem;
    color: var(--theme-ink-muted);
  }
  .disc__crumbs a {
    color: var(--theme-ink-muted);
    text-decoration: none;
  }
  .disc__crumbs a:hover {
    color: var(--theme-accent);
  }
  .disc__crumbs [aria-current='page'] {
    color: var(--theme-ink);
  }

  .disc__head {
    margin: clamp(1rem, 4vw, 2.5rem) 0 clamp(1.5rem, 4vw, 2.5rem);
  }
  .disc__title {
    font-family: var(--theme-font-display);
    font-size: clamp(2.5rem, 8vw, 5rem);
    line-height: 1;
    color: var(--theme-accent);
    margin: 0;
  }
  .disc__tagline {
    margin: 0.75rem 0 0;
    max-width: 52ch;
    color: var(--theme-ink-muted);
    font-family: var(--theme-font-body);
  }


  [data-discipline='design'] {
    /* Float the breadcrumb so it doesn't push the hero down off the door's
       centre line; the hero then fills the first screen on its own. */
    position: relative;
    padding-top: 0;
  }
  [data-discipline='design'] .disc__crumbs {
    position: absolute;
    top: clamp(1rem, 3vw, 2rem);
    left: clamp(1rem, 4vw, 2.5rem);
    z-index: 1;
  }
  [data-discipline='design'] .disc__head {
    /* Centre on the FULL viewport midline, exactly like the door (a fixed
       inset:0 panel with place-items:center → label centre = 50dvh). main's
       offsetTop equals the sticky nav height, so the head fills 100dvh and is
       pulled up by that same token; centring then lands on 50dvh instead of
       ~navHeight/2 below it. */
    position: relative;
    min-height: 100dvh;
    margin: calc(-1 * clamp(60px, 10vh, 80px)) 0 0;
    display: grid;
    place-content: center;
    text-align: center;
  }
  [data-discipline='design'] .disc__title {
    /* Type spec copied verbatim from .pull__door-label (incl. its default
       line-height: normal) so the wordmark doesn't jump in font, size, weight,
       tracking, OR vertical glyph position when the page swaps in. */
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(3rem, 12vw, 12rem);
    letter-spacing: -0.02em;
    /* Explicit `normal` (not the base .disc__title's line-height:1) to match the
       door label's box height, so the glyph centres on the identical midline. */
    line-height: normal;
    color: var(--theme-ink);
  }
  [data-discipline='design'] .disc__tagline {
    /* Taken out of the centred grid so ONLY the title sits on the midline (the
       door stub has no tagline). Anchored just below the title — the offset is
       ~half the title's line box, derived from the same font-size token. */
    position: absolute;
    left: 50%;
    top: calc(50% + clamp(3rem, 12vw, 12rem) * 0.62);
    transform: translateX(-50%);
    margin: 0;
    width: max-content;
    max-width: 88vw;
  }

  /* ----- Hero ----- */
  .disc__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    text-decoration: none;
    color: inherit;
    background: var(--theme-surface);
    border: var(--border-width-medium) solid var(--theme-border);
    border-radius: var(--theme-radius);
    overflow: hidden;
    transition: border-color var(--duration-medium) var(--theme-motion-ease),
      transform var(--duration-medium) var(--theme-motion-ease);
  }
  .disc__hero:hover {
    border-color: var(--theme-accent);
    transform: var(--transform-translate-up-small);
  }
  .disc__hero-media {
    position: relative;
    min-height: 240px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--theme-accent) 12%, transparent);
  }
  .disc__hero-media img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    transform-origin: top left;
    transform: translate(var(--cover-x, 0px), var(--cover-y, 0px))
      scale(var(--cover-scale, 1));
  }
  .disc__hero-body {
    padding: clamp(1.25rem, 3vw, 2rem);
    align-self: center;
  }
  .disc__hero-body h2 {
    font-family: var(--theme-font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0.35rem 0 0.6rem;
  }
  .disc__hero-body p {
    margin: 0 0 1rem;
    color: var(--theme-ink-muted);
    font-family: var(--theme-font-body);
    line-height: 1.5;
  }
  .disc__eyebrow {
    font-family: var(--theme-font-body);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--theme-accent);
  }

  .disc__placeholder {
    font-family: var(--theme-font-display);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 800;
    color: var(--theme-accent);
    opacity: 0.5;
  }

  /* ----- Tag chips ----- */
  .disc__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .disc__tags li {
    font-family: var(--theme-font-body);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    padding: 0.2em 0.7em;
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-pill);
    color: var(--theme-ink-muted);
  }

  /* ----- Grid ----- */
  .disc__grid {
    list-style: none;
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: clamp(1rem, 3vw, 1.75rem);
  }

  .disc-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    background: var(--theme-surface);
    border: var(--border-width-medium) solid var(--theme-border);
    border-radius: var(--theme-radius);
    overflow: hidden;
    transition: border-color var(--duration-medium) var(--theme-motion-ease),
      transform var(--duration-medium) var(--theme-motion-ease);
  }
  .disc-card:hover {
    border-color: var(--theme-accent);
    transform: var(--transform-translate-up-small);
  }
  .disc-card:focus-within {
    outline: 2px solid var(--theme-accent);
    outline-offset: 3px;
  }
  /* Stretched link — whole card is clickable. */
  .disc-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .disc-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--theme-accent) 10%, transparent);
  }
  .disc-card__media img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    transform-origin: top left;
    transform: translate(var(--cover-x, 0px), var(--cover-y, 0px))
      scale(var(--cover-scale, 1));
  }
  .disc-card__body {
    padding: 1rem 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .disc-card__title {
    font-family: var(--theme-font-display);
    font-size: 1.3rem;
    margin: 0;
  }
  .disc-card__desc {
    margin: 0;
    font-family: var(--theme-font-body);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--theme-ink-muted);
  }
  .disc-card__index {
    position: absolute;
    top: 0.6rem;
    left: 0.7rem;
    z-index: 3;
    font-family: var(--font-primary);
    font-size: 0.75rem;
    color: var(--idiom-accent);
    opacity: 0;
    transition: opacity var(--duration-medium) var(--theme-motion-ease);
  }

  .disc__empty {
    margin: clamp(2rem, 6vw, 4rem) 0;
    max-width: 48ch;
    color: var(--theme-ink-muted);
    font-family: var(--theme-font-body);
  }

  /* ===== Engineering idiom: dimension callouts =====
     On hover, a card draws blueprint-style dimension lines (an L of measured
     edges with end ticks) plus its index, in the idiom tokens. Other
     disciplines set a different data-idiom and simply don't match this block —
     their idioms slot in here later against the same markup. */
  [data-idiom='dimension'] .disc-card__dim {
    position: absolute;
    inset: 0.5rem;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-medium) var(--theme-motion-ease);
    /* top + left dimension lines */
    border-top: 1px solid var(--idiom-rule);
    border-left: 1px solid var(--idiom-rule);
  }
  /* End ticks at the two open ends of the L. */
  [data-idiom='dimension'] .disc-card__dim::before,
  [data-idiom='dimension'] .disc-card__dim::after {
    content: '';
    position: absolute;
    background: var(--idiom-rule);
  }
  [data-idiom='dimension'] .disc-card__dim::before {
    top: -4px;
    right: 0;
    width: 1px;
    height: 9px;
  }
  [data-idiom='dimension'] .disc-card__dim::after {
    left: -4px;
    bottom: 0;
    width: 9px;
    height: 1px;
  }
  [data-idiom='dimension'] .disc-card:hover .disc-card__dim {
    opacity: 1;
  }
  [data-idiom='dimension'] .disc-card:hover .disc-card__index {
    opacity: 1;
  }

  @media (max-width: 700px) {
    .disc__hero {
      grid-template-columns: 1fr;
    }
  }
</style>
