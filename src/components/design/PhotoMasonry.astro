---
import type { CollectionEntry } from 'astro:content';
import { resolveCardAction, cardNavigates, coverStyle } from '../../lib/design-links';
import { DESIGN_WIP, STUB_COUNTS, stubList } from '../../lib/design-stub';

interface Props {
  items: CollectionEntry<'design'>[];
}
const { items } = Astro.props;

const COLS = 4;
const columns: CollectionEntry<'design'>[][] = Array.from({ length: COLS }, () => []);
items.forEach((it, i) => columns[i % COLS].push(it));
---

<div class="masonry crop-tb">
  {
    DESIGN_WIP
      ? Array.from({ length: COLS }, (_, i) => (
          <div class="m-col" data-drift="y" data-dir={i % 2 === 0 ? -1 : 1}>
            {stubList(Math.ceil(STUB_COUNTS.masonry / COLS)).map(() => (
              <div class="m-card is-stub" aria-hidden="true">
                <div class="m-media" />
                <div class="m-label">
                  <span class="stub-cap">Work in Progress</span>
                </div>
              </div>
            ))}
          </div>
        ))
      : columns.map((col, i) => (
      <div class="m-col" data-drift="y" data-dir={i % 2 === 0 ? -1 : 1}>
        {col.map((it) => {
          const action = resolveCardAction(it);
          const nav = cardNavigates(action);
          return (
          <a
            class:list={['m-card', { 'is-inert': !nav }]}
            href={nav ? action.href : undefined}
            data-card-action={action.kind}
            aria-disabled={!nav ? 'true' : undefined}
            draggable={false}
          >
            <div class="m-media">
              {it.data.sprite ? (
                <img class="m-sprite" src={it.data.sprite} data-freeze={it.data.spriteStatic} alt="" draggable={false} style={coverStyle(it.data)} />
              ) : it.data.cover ? (
                <img src={it.data.cover} alt="" loading="lazy" decoding="async" style={coverStyle(it.data)} />
              ) : null}
            </div>
            <div class="m-label">
              <b>{it.data.title}</b>
              <span>{it.data.tools?.[0] ?? it.data.category}</span>
            </div>
          </a>
          );
        })}
      </div>
    ))
  }
</div>

<style>
  .masonry {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    /* Taller viewport so more of the cycling gallery is visible at once. */
    height: 124vh;
    overflow: hidden;
    padding-inline: var(--dp-bleed);
    margin-inline: calc(-1 * var(--dp-bleed));
  }
  .m-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
    align-self: start;
    will-change: transform;
  }
  .m-card {
    position: relative;
    display: block;
    border-radius: 5px;
    overflow: hidden;
    border: 1px solid var(--dp-line);
    background: var(--dp-card);
    text-decoration: none;
    transition: box-shadow 0.5s var(--dp-ease), transform 0.4s var(--dp-ease);
  }
  .m-card:hover {
    box-shadow: var(--dp-shadow);
    transform: scale(1.05);
    z-index: 2;
  }
  /* Inert placeholder (href '#' → no destination yet): keep the hover lift so the
     gallery still feels alive, but reset the cursor so it doesn't promise a click
     target that isn't there. */
  .m-card.is-inert {
    cursor: default;
  }
  /* Whole-page WIP stub: blank placeholder tile (see src/lib/design-stub.ts).
     Coverless tiles already take their height from the nth-child media ratios
     above, giving a naturally ragged skeleton. */
  .m-card.is-stub {
    cursor: default;
  }
  .m-card.is-stub:hover {
    transform: none;
    box-shadow: none;
  }
  .m-card.is-stub:hover .m-media {
    transform: none;
  }
  .stub-cap {
    font-family: var(--dp-font-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--dp-muted);
  }
  .m-media {
    overflow: hidden;
    /* A STABLE default aspect so the vertical drift measures a correct loop period
       before lazy covers load; classifyMasonry() (design.astro) then sets the real
       per-image aspect and the drift re-measures. Fixed heights (not height:auto)
       are what keep the infinite cycling smooth instead of jumping as covers load. */
    aspect-ratio: 3 / 4;
    background: linear-gradient(150deg, #e9e3d6, #d5ccb9);
    transition: transform 0.6s var(--dp-ease);
  }
  .m-card:hover .m-media {
    transform: scale(1.06);
  }
  /* Covers FILL the box (object-fit: cover → no letterbox bars); the box's shape
     is chosen per-image by classifyMasonry so the crop is minimal. */
  .m-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .m-media.is-landscape {
    aspect-ratio: 3 / 2;
  }
  .m-media.is-square {
    aspect-ratio: 1 / 1;
  }
  .m-media.is-portrait {
    aspect-ratio: 3 / 4;
  }
  /* Pixel-art sprite — crisp nearest-neighbour on a flat tint; contained by default
     (a logo fits whole), while a piece flagged coverFit:'cover' (Guy) fills the
     frame via its inline object-fit override. */
  .m-media :global(.m-sprite) {
    object-fit: contain;
    image-rendering: pixelated;
    background: #1b1b20;
  }
  

  .m-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(0deg, rgba(243, 239, 230, 0.92) 0%, rgba(243, 239, 230, 0) 42%);
  }
  .m-label {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 14px;
    z-index: 2;
  }
  .m-label b {
    display: block;
    font-family: var(--dp-font-title);
    font-size: 17px;
    font-weight: 400;
    text-transform: uppercase;
  }
  .m-label span {
    font-size: 12px;
    color: var(--dp-muted);
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .masonry {
      height: auto;
      overflow: visible;
    }
    .m-col {
      transform: none !important;
      will-change: auto;
    }
  }
  
  :global([data-sim-reduced]) .masonry {
    height: auto;
    overflow: visible;
  }
  :global([data-sim-reduced]) .m-col {
    transform: none !important;
    will-change: auto;
  }

  @media (max-width: 900px) {
    .masonry {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .masonry {
      height: auto;
      overflow: visible;
    }
    .m-col {
      transform: none;
    }
  }
</style>
