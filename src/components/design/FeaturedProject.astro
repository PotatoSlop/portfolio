---
/*
  FeaturedProject — the Featured / Most-recent pick that opens the /design
  gallery, directly under the hero-only first viewport.

  EDITORIAL SPLIT (chosen from the featured-layouts prototype): a text column
  (tag · title · meta · summary · CTA) beside a media box at a FIXED HEIGHT
  whose aspect ratio is the image's own (`--ar`, read at build time by
  src/lib/image-meta.ts). Nothing is cropped whatever the image's shape; any
  space the box can't use is painted in the image's sampled edge colour, so it
  reads as part of the image, not a letterbox bar. A wide image squeezes the
  text column to its minimum; a tall one gives it more room. Stacks on mobile.

  Featured / Most recent tabs switch picks (cross-fade); a countdown advances
  them while the card is on screen. Clicking the media advances to the next
  pick (it is a cycler, not a link); only the CTA opens the project. Picks
  come only from UI/UX + 3D entries (chosen in design.astro).
  The strip reveal fires on scroll-into-view (src/lib/motion/design-reveal.ts).
*/
import type { CollectionEntry } from 'astro:content';
import { resolveCardAction, primaryTagLabel, type CardAction } from '../../lib/design-links';
import { DESIGN_WIP } from '../../lib/design-stub';
import { imageMeta } from '../../lib/image-meta';

interface Props {
  featured: CollectionEntry<'design'>;
  recent: CollectionEntry<'design'>;
}
const { featured, recent } = Astro.props;

const metaLine = (e: CollectionEntry<'design'>) => [primaryTagLabel(e), e.data.tools?.[0], e.data.year].filter(Boolean).join(' · ');

// The CTA mirrors the card actions (src/lib/design-links.ts): a gated UI/UX
// pick can't be read yet, so its CTA is inert; a wired 3D pick opens the viewer.
const ctaLabel = (a: CardAction) => {
  switch (a.kind) {
    case 'model':
      return 'Open 3D viewer';
    case 'case':
      return 'Read case study';
    case 'gated':
      return 'Case study in progress';
    default:
      return 'View project';
  }
};

interface Mode {
  tag: string;
  title: string;
  meta: string;
  summary: string;
  kind: string;
  href: string;
  glb: string;
  cta: string;
  cover: string;
  w: number;
  h: number;
  edge: string;
}

const item = async (e: CollectionEntry<'design'>, tag: string): Promise<Mode> => {
  const action = resolveCardAction(e);
  const cover = e.data.cover ?? '';
  const m = await imageMeta(cover);
  return {
    tag,
    title: e.data.title,
    meta: metaLine(e),
    summary: e.data.summary ?? '',
    // Only 'case'/'link' navigate; 'model' opens the viewer via data attrs; the
    // rest are inert (no destination yet).
    kind: action.kind,
    href: action.kind === 'case' || action.kind === 'link' ? action.href : '',
    glb: action.kind === 'model' ? action.glb : '',
    cta: ctaLabel(action),
    cover,
    w: m.width,
    h: m.height,
    edge: m.edge,
  };
};

// Whole-page WIP stub: no picks, a blank frame (see src/lib/design-stub.ts).
const modes: Mode[] = DESIGN_WIP
  ? []
  : featured.id === recent.id
    ? [await item(featured, 'Featured')]
    : [await item(featured, 'Featured'), await item(recent, 'Most recent')];
const multi = modes.length > 1;

// ---- Interior markup. The client cycler (script below) builds the SAME string
// for each switch; keep the two builders in step. `next` is the following
// pick's title: when given, the media becomes the cycler's "next" control
// (a full-cover button) instead of a dead box. ----
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const actionAttrs = (m: Mode) =>
  m.kind === 'model' ? `href="#" data-card-action="model" data-glb="${esc(m.glb)}" role="button"` : m.href ? `href="${esc(m.href)}"` : '';
const buildInner = (m: Mode, next?: string) => {
  const live = m.kind !== 'gated' && m.kind !== 'dead';
  const cta = live
    ? `<a class="fs-cta" ${actionAttrs(m)}>${esc(m.cta)}</a>`
    : `<span class="fs-cta is-disabled" aria-disabled="true">${esc(m.cta)}</span>`;
  const img = m.cover ? `<img src="${esc(m.cover)}" alt="" width="${m.w}" height="${m.h}" decoding="async">` : '';
  const hit = next
    ? `<button type="button" class="fs-next" data-fc-next aria-label="Next pick: ${esc(next)}"><span>Next →</span></button>`
    : '';
  return (
    `<div class="fs-text">` +
    `<span class="fs-k">${esc(m.tag)}</span>` +
    `<span class="fs-t" style="--fs-chars:${Math.max(4, ...m.title.split(/\s+/).map((w) => w.length))}">${esc(m.title)}</span>` +
    `<span class="fs-m">${esc(m.meta)}</span>` +
    (m.summary ? `<p class="fs-s">${esc(m.summary)}</p>` : '') +
    cta +
    `</div>` +
    `<div class="fs-media${next ? ' is-cycle' : ''}" style="--ar:${m.w} / ${m.h};--edgec:${esc(m.edge)}">${img}${hit}</div>`
  );
};
const first = modes[0];
---

<section id="dp-featured" aria-label="Featured work">
  <div class="feat-cycler crop-lr" role="group" aria-label="Featured work" data-multi={String(multi)}>
    {
      modes.map((m, i) => (
        <button type="button" class="fc-tab" data-fc-tab={String(i)} aria-pressed={i === 0 ? 'true' : 'false'}>
          {m.tag}
        </button>
      ))
    }
    <span class="hc-progress" aria-hidden="true">
      {
        modes.map((_, i) => (
          <span class="hc-seg">
            <span class="hc-seg__fill" data-hc-seg={String(i)} />
          </span>
        ))
      }
    </span>
  </div>

  <div class:list={['feat-card', 'pre-anim', { 'is-stub': DESIGN_WIP }]} id="featCard" data-hero={DESIGN_WIP ? undefined : JSON.stringify(modes)}>
    {
      DESIGN_WIP ? (
        <div class="hf-inner">
          <div class="fs-text">
            <span class="fs-t">Work in Progress</span>
          </div>
        </div>
      ) : (
        <div class="hf-inner" set:html={buildInner(first, modes[1]?.title)} />
      )
    }
  </div>
</section>

<style>
  #dp-featured {
    /* Fixed height of the split on desktop: tall enough to feature, short enough
       that switching picks never moves the page. */
    --feat-h: clamp(380px, 58vh, 620px);
    padding: 6vh var(--dp-edge) 0;
    scroll-margin-top: 72px;
  }

  /* ===== Tabs + countdown ===== */
  .feat-cycler {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
  }
  .fc-tab {
    padding: 0;
    border: 0;
    background: none;
    font: 600 12px/1 var(--dp-font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dp-muted);
    cursor: pointer;
    transition: color 0.25s;
  }
  .fc-tab:hover,
  .fc-tab[aria-pressed='true'] {
    color: var(--dp-accent-deep);
  }
  .fc-tab:focus-visible {
    outline: 2px solid var(--dp-accent-deep);
    outline-offset: 4px;
  }
  .hc-progress {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 3px;
  }
  .hc-seg {
    flex: 1;
    height: 100%;
    border-radius: 2px;
    background: var(--dp-line);
    overflow: hidden;
  }
  .hc-seg__fill {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--dp-accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .feat-cycler[data-multi='false'] .hc-progress {
    display: none;
  }
  /* Reduced motion: no auto-advance, so the countdown has nothing to count. */
  @media (prefers-reduced-motion: reduce) {
    .hc-progress {
      visibility: hidden;
    }
  }
  :global([data-sim-reduced]) .hc-progress {
    visibility: hidden;
  }

  /* ===== The split =====
     Layers (.hf-inner) stack in ONE grid cell so a cross-fade overlays the old
     and new pick without absolute positioning — the card keeps a real height on
     mobile, where it stacks. */
  .feat-card {
    position: relative; /* hosts the strip reveal's .br-box */
    display: grid;
    margin-top: 18px;
  }
  :global(.feat-card > .hf-inner) {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(260px, 1fr) auto;
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
    height: var(--feat-h);
  }

  /* Interior nodes are rebuilt by the cycler (no scope id) → :global. */
  :global(.fs-text) {
    /* A size container so the title can fit ITS column (cqi), which a wide
       image squeezes to ~260px. */
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
    width: 100%;
  }
  :global(.fs-k) {
    font: 600 12px/1 var(--dp-font-body);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dp-accent-deep);
  }
  /* Capped so the LONGEST WORD fits the column on one line (--fs-chars is set
     per pick; a display glyph is ~0.92em wide): wraps between words, never
     mid-word, however narrow a wide image leaves the column. */
  :global(.fs-t) {
    font-family: var(--dp-font-title);
    font-weight: 400;
    font-size: min(clamp(28px, 3.6vw, 56px), calc(100cqi / (var(--fs-chars, 6) * 0.92)));
    line-height: 0.95;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--dp-ink);
    max-width: 100%;
  }
  :global(.fs-m) {
    font: 500 14px/1.3 var(--dp-font-body);
    color: var(--dp-muted);
  }
  :global(.fs-s) {
    max-width: 38ch;
    margin: 4px 0 6px;
    font: 400 16px/1.55 var(--dp-font-body);
    color: var(--dp-ink);
  }
  /* CTA: solid navy face, amber rising on hover (the hero button's twin). */
  :global(.fs-cta) {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    margin-top: 6px;
    padding: 11px 20px;
    border: 1px solid var(--dp-ink);
    border-radius: 5px;
    background: var(--dp-ink);
    color: var(--dp-paper);
    font: 600 12px/1 var(--dp-font-body);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.4s var(--dp-ease), border-color 0.4s var(--dp-ease);
  }
  :global(.fs-cta)::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--dp-accent);
    transform: translateY(100%);
    transition: transform 0.4s var(--dp-ease);
  }
  :global(.fs-cta:hover),
  :global(.fs-cta:focus-visible) {
    color: #16233a;
    border-color: var(--dp-accent);
    outline: none;
  }
  :global(.fs-cta:hover)::before,
  :global(.fs-cta:focus-visible)::before {
    transform: none;
  }
  :global(.fs-cta.is-disabled) {
    opacity: 0.55;
    cursor: default;
    pointer-events: none;
  }

  /* Media: the image's own shape at the split's height (width = height × ratio),
     capped so the text column keeps ~300px. Contained, never cropped; spare
     space takes the image's edge colour. */
  :global(.fs-media) {
    position: relative; /* hosts the full-cover .fs-next cycler button */
    display: block;
    justify-self: end;
    height: var(--feat-h);
    aspect-ratio: var(--ar);
    max-width: min(72vw, calc(100vw - 2 * var(--dp-edge) - 320px));
    overflow: hidden;
    border: 1px solid var(--dp-line);
    border-radius: 5px;
    background: var(--edgec, #e9e3d6);
    transition: box-shadow 0.5s var(--dp-ease);
  }
  :global(.fs-media.is-cycle:hover) {
    box-shadow: var(--dp-shadow);
  }
  :global(.fs-media img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.6s var(--dp-ease);
  }
  :global(.fs-media.is-cycle:hover img) {
    transform: scale(1.02);
  }
  /* The media is the cycler's "next" control: a transparent button over the
     whole image, with a small chip bottom-right that names what a click does
     (shown on hover/focus; always on for touch, which has no hover). */
  :global(.fs-next) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 14px;
    border: 0;
    background: none;
    cursor: pointer;
  }
  :global(.fs-next:focus-visible) {
    outline: none;
  }
  /* Ring the media box itself (its overflow would clip a ring on the button). */
  :global(.fs-media:has(.fs-next:focus-visible)) {
    outline: 2px solid var(--dp-accent-deep);
    outline-offset: 4px;
  }
  :global(.fs-next span) {
    padding: 8px 12px;
    border-radius: 5px;
    background: var(--dp-ink);
    color: var(--dp-paper);
    font: 600 11px/1 var(--dp-font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s var(--dp-ease), transform 0.5s var(--dp-ease);
  }
  :global(.fs-media.is-cycle:hover .fs-next span),
  :global(.fs-next:focus-visible span) {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    :global(.fs-next span) {
      opacity: 1;
      transform: none;
    }
  }

  /* During the strip reveal the media's 1px border sits outside the fill and
     flickers; hold it transparent until the reveal ends. */
  .feat-card.pre-anim :global(.fs-media),
  .feat-card.br--go :global(.fs-media) {
    border-color: transparent;
  }

  /* Stacked: text above, media full width at its own ratio (capped tall). */
  @media (max-width: 900px) {
    :global(.feat-card > .hf-inner) {
      grid-template-columns: minmax(0, 1fr);
      height: auto;
      gap: 20px;
    }
    :global(.fs-media) {
      justify-self: stretch;
      width: 100%;
      height: auto;
      max-width: none;
      max-height: 70vh;
    }
  }
</style>

<script>
  import { prefersReducedMotion } from '../../lib/motion/reduced-motion';
  import { onPageReady } from '../../lib/motion/lifecycle';

  interface Mode {
    tag: string;
    title: string;
    meta: string;
    summary: string;
    kind: string;
    href: string;
    glb: string;
    cta: string;
    cover: string;
    w: number;
    h: number;
    edge: string;
  }

  const AUTO_MS = 7000; // dwell before switching to the next pick

  // ---- Same builder as the SSR frontmatter; keep them in step. ----
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const actionAttrs = (m: Mode) =>
    m.kind === 'model' ? `href="#" data-card-action="model" data-glb="${esc(m.glb)}" role="button"` : m.href ? `href="${esc(m.href)}"` : '';
  const buildInner = (m: Mode, next?: string) => {
    const live = m.kind !== 'gated' && m.kind !== 'dead';
    const cta = live
      ? `<a class="fs-cta" ${actionAttrs(m)}>${esc(m.cta)}</a>`
      : `<span class="fs-cta is-disabled" aria-disabled="true">${esc(m.cta)}</span>`;
    const img = m.cover ? `<img src="${esc(m.cover)}" alt="" width="${m.w}" height="${m.h}" decoding="async">` : '';
    const hit = next
      ? `<button type="button" class="fs-next" data-fc-next aria-label="Next pick: ${esc(next)}"><span>Next →</span></button>`
      : '';
    return (
      `<div class="fs-text">` +
      `<span class="fs-k">${esc(m.tag)}</span>` +
      `<span class="fs-t" style="--fs-chars:${Math.max(4, ...m.title.split(/\s+/).map((w) => w.length))}">${esc(m.title)}</span>` +
      `<span class="fs-m">${esc(m.meta)}</span>` +
      (m.summary ? `<p class="fs-s">${esc(m.summary)}</p>` : '') +
      cta +
      `</div>` +
      `<div class="fs-media${next ? ' is-cycle' : ''}" style="--ar:${m.w} / ${m.h};--edgec:${esc(m.edge)}">${img}${hit}</div>`
    );
  };

  function initFeatured(): (() => void) | null {
    const card = document.getElementById('featCard');
    if (!card) return null;
    let modes: Mode[];
    try {
      modes = JSON.parse(card.dataset.hero || '[]');
    } catch {
      return null;
    }
    if (!Array.isArray(modes) || modes.length < 2) return null; // nothing to cycle

    // Warm the other picks' images so a switch never flashes empty.
    modes.forEach((m) => m.cover && (new Image().src = m.cover));

    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-fc-tab]')];
    const segs = [...document.querySelectorAll<HTMLElement>('[data-hc-seg]')];
    // Phones are always reduced-motion on this site; check the breakpoint too, since
    // this can mount before the page sets html[data-sim-reduced].
    const reduced = prefersReducedMotion() || window.matchMedia('(max-width: 768px)').matches;
    let idx = 0;
    let raf = 0;
    let runStart = 0;
    let elapsed = 0; // countdown already spent before a pause (off-screen)
    let visible = false;
    const timers = new Set<number>();

    const paintSegs = (active: number, p: number) =>
      segs.forEach((fill, i) => {
        const v = i < active ? 1 : i === active ? Math.max(0, Math.min(p, 1)) : 0;
        fill.style.transform = `scaleX(${v})`;
      });

    const inner = (i: number) => buildInner(modes[i], modes[(i + 1) % modes.length].title);
    const render = (i: number) => {
      tabs.forEach((t, k) => t.setAttribute('aria-pressed', String(k === i)));
      const layers = [...card.querySelectorAll<HTMLElement>('.hf-inner')];
      const old = layers[layers.length - 1] ?? null;
      layers.slice(0, -1).forEach((l) => l.remove()); // collapse rapid-switch stragglers
      // Keyboard users who cycled via the media keep focus on the new pick's
      // "next" button instead of dropping to <body> when the old layer goes.
      const refocus = !!old?.contains(document.activeElement) && document.activeElement?.matches('[data-fc-next]');
      if (reduced || !old) {
        if (old) old.innerHTML = inner(i);
        if (refocus) old?.querySelector<HTMLElement>('[data-fc-next]')?.focus();
        return;
      }
      // Cross-fade: both layers share one grid cell, the new one eases in on top.
      const nu = document.createElement('div');
      nu.className = 'hf-inner';
      nu.style.opacity = '0';
      nu.innerHTML = inner(i);
      card.appendChild(nu);
      if (refocus) nu.querySelector<HTMLElement>('[data-fc-next]')?.focus({ preventScroll: true });
      void nu.offsetWidth;
      nu.style.transition = old.style.transition = 'opacity 0.5s var(--dp-ease)';
      nu.style.opacity = '1';
      old.style.opacity = '0';
      old.style.pointerEvents = 'none';
      const t = window.setTimeout(() => {
        old.remove();
        nu.style.transition = '';
        timers.delete(t);
      }, 560);
      timers.add(t);
    };

    const stop = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    };
    const frame = () => {
      const p = (elapsed + performance.now() - runStart) / AUTO_MS;
      paintSegs(idx, p);
      if (p >= 1) {
        raf = 0;
        go((idx + 1) % modes.length);
        return;
      }
      raf = requestAnimationFrame(frame);
    };
    const run = () => {
      if (reduced || raf || !visible) return;
      runStart = performance.now();
      raf = requestAnimationFrame(frame);
    };
    const pause = () => {
      if (!raf) return;
      elapsed += performance.now() - runStart;
      stop();
    };
    const go = (i: number) => {
      idx = i;
      render(idx);
      stop();
      elapsed = 0;
      paintSegs(idx, reduced ? 1 : 0);
      run();
    };

    const onTab = (e: Event) => {
      const i = Number((e.currentTarget as HTMLElement).dataset.fcTab);
      if (i !== idx) go(i);
    };
    tabs.forEach((t) => t.addEventListener('click', onTab));
    // Clicking the media advances to the next pick (delegated: layers are rebuilt
    // on every switch; a fading-out layer has pointer-events: none).
    const onCard = (e: Event) => {
      if ((e.target as Element).closest('[data-fc-next]')) go((idx + 1) % modes.length);
    };
    card.addEventListener('click', onCard);

    // Below the fold: only count down while the card is on screen.
    const io = new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        if (visible) run();
        else pause();
      },
      { threshold: 0.35 }
    );
    io.observe(card);
    paintSegs(0, reduced ? 1 : 0);

    return () => {
      stop();
      io.disconnect();
      tabs.forEach((t) => t.removeEventListener('click', onTab));
      card.removeEventListener('click', onCard);
      timers.forEach((t) => clearTimeout(t));
      timers.clear();
    };
  }

  onPageReady('#featCard', () => initFeatured());
</script>
