---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'design'>[];
  dir?: number; // -1 drifts left, 1 drifts right
}
const { items, dir = -1 } = Astro.props;

// One corner badge per card. A 'stub' marker (placeholder entry — e.g. a 3D
// model with no viewer wired up yet) takes precedence over 'game-asset', since
// flagging the unfinished state is the point of showing it at all.
const badgeFor = (it: CollectionEntry<'design'>) =>
  it.data.tags?.includes('stub') ? 'stub' : it.data.tags?.includes('game-asset') ? 'game-asset' : null;
---

<div class="row-viewport crop-tb">
  <div class="row-track" data-drift="x" data-dir={dir}>
    {
      items.map((it) => (
        <a class="d-card" href={it.data.href ?? '#'} draggable={false}>
          <div class="d-media">
            {it.data.cover && (
              <Image src={it.data.cover} alt="" format="webp" widths={[420, 640]} sizes="(max-width: 768px) 90vw, 34vw" />
            )}
          </div>
          {badgeFor(it) && <span class="d-tag" data-stub={badgeFor(it) === 'stub' ? 'true' : 'false'}>{badgeFor(it)}</span>}
          <div class="d-label">
            <b>{it.data.title}</b>
            <span>{it.data.category}</span>
          </div>
        </a>
      ))
    }
  </div>
</div>

<style>
  .row-viewport {
    overflow: hidden;
    touch-action: pan-y;
    padding-block: var(--dp-bleed);
    margin-block: calc(-1 * var(--dp-bleed));
  }
  .row-track {
    display: flex;
    gap: 26px;
    will-change: transform;
  }
  .d-card {
    position: relative;
    flex: 0 0 clamp(360px, 34vw, 520px);
    aspect-ratio: 4 / 3;
    border-radius: 5px;
    overflow: hidden;
    border: 1px solid var(--dp-line);
    background: var(--dp-card);
    cursor: pointer;
    text-decoration: none;
    -webkit-user-drag: none;
    user-select: none;
    transition: box-shadow 0.5s var(--dp-ease), transform 0.4s var(--dp-ease);
  }
  .d-card:hover {
    box-shadow: var(--dp-shadow);
    transform: scale(1.05);
    z-index: 2; /* lift the scaled card above its neighbours */
  }
  .d-media {
    position: absolute;
    inset: 0;
    background: linear-gradient(155deg, #2a2a2e, #141416);
    transition: transform 0.6s var(--dp-ease);
  }
  /* Cover image fills the media frame; the gradient shows through only when a
     card has no cover yet (stubs). */
  .d-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .d-card:hover .d-media {
    transform: scale(1.07);
  }
  .d-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(0deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0) 42%);
  }
  .d-label {
    position: absolute;
    left: 18px;
    bottom: 16px;
    right: 18px;
    z-index: 2;
  }
  .d-label b {
    display: block;
    font-family: var(--dp-font-title);
    font-size: 20px;
    font-weight: 400;
    text-transform: uppercase;
  }
  .d-label span {
    font-size: 12px;
    color: var(--dp-muted);
    text-transform: uppercase;
  }
  .d-tag {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    font-size: 10.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: var(--dp-ink);
    color: var(--dp-paper);
    padding: 4px 9px;
    border-radius: 3px;
  }
  /* Stub marker — amber fill so an unfinished/placeholder card reads distinctly
     from the neutral game-asset tag. */
  .d-tag[data-stub='true'] {
    background: var(--dp-accent);
    color: var(--dp-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .row-viewport {
      overflow-x: auto;
    }
    .d-card:hover,
    .d-card:hover .d-media {
      transform: none;
    }
  }
  :global([data-sim-reduced]) .row-viewport {
    overflow-x: auto;
  }
  :global([data-sim-reduced]) .d-card:hover,
  :global([data-sim-reduced]) .d-card:hover .d-media {
    transform: none;
  }

  /* ===== Mobile: FIFO card queue ===== */
  @media (max-width: 768px) {
    .row-viewport {
      position: relative;
      padding-block: 0;
      margin-block: 0;
    }
    .row-viewport.is-queue .row-track {
      display: block;
    }
    .row-viewport.is-queue .d-card {
      display: none;
      width: 100%;
    }
    .row-viewport.is-queue .d-card:first-child {
      display: block; /* the queue front */
    }
    .d-card:hover {
      transform: none; /* touch: no scale */
    }
  }

  /* Chevron nav buttons */
  :global(.row-viewport .queue-nav) {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }
  :global(.row-viewport .queue-nav__btn) {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    background: none;
    color: var(--dp-accent);
    cursor: pointer;
    pointer-events: auto;
    filter: drop-shadow(0 1px 2px rgba(20, 18, 12, 0.45));
    -webkit-tap-highlight-color: transparent;
  }
  :global(.row-viewport .queue-nav__btn--prev) {
    left: 2px;
  }
  :global(.row-viewport .queue-nav__btn--next) {
    right: 2px;
  }
  :global(.row-viewport .queue-nav__btn svg) {
    display: block;
  }
</style>
