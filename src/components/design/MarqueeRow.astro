---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'design'>[];
  dir?: number; // -1 drifts left, 1 drifts right
}
const { items, dir = -1 } = Astro.props;
---

<div class="row-viewport crop-tb">
  <div class="row-track" data-drift="x" data-dir={dir}>
    {
      items.map((it) => (
        <a class="d-card" href={it.data.href ?? '#'} draggable={false}>
          <div class="d-media" />
          {it.data.tags?.includes('game-asset') && <span class="d-tag">game-asset</span>}
          <div class="d-label">
            <b>{it.data.title}</b>
            <span>{it.data.category}</span>
          </div>
        </a>
      ))
    }
  </div>
</div>

<style>
  .row-viewport {
    overflow: hidden;
    /* Horizontal swipes scrub the row; vertical stays page scroll. */
    touch-action: pan-y;
    /* The clip region (overflow + the crop-tb reveal's clip-path) sits at the
       padding box, so pad the frame and pull it back out by the same amount:
       layout is unchanged but a hover-scaled card (1.05) now has vertical room
       to grow into instead of being cropped at the top/bottom edge. Sized to the
       shadow's reach via the shared bleed token. The row is still a horizontal
       scrub window, so left/right stay clipped by design. */
    padding-block: var(--dp-bleed);
    margin-block: calc(-1 * var(--dp-bleed));
  }
  .row-track {
    display: flex;
    gap: 26px;
    will-change: transform;
  }
  .d-card {
    position: relative;
    flex: 0 0 clamp(360px, 34vw, 520px);
    aspect-ratio: 4 / 3;
    border-radius: 5px;
    overflow: hidden;
    border: 1px solid var(--dp-line);
    background: var(--dp-card);
    cursor: pointer;
    text-decoration: none;
    /* So grabbing ON a card scrubs the row instead of starting a native
       link/image drag (which otherwise swallows the pointer stream). */
    -webkit-user-drag: none;
    user-select: none;
    transition: box-shadow 0.5s var(--dp-ease), transform 0.4s var(--dp-ease);
  }
  .d-card:hover {
    box-shadow: var(--dp-shadow);
    transform: scale(1.05);
    z-index: 2; /* lift the scaled card above its neighbours */
  }
  .d-media {
    position: absolute;
    inset: 0;
    background: linear-gradient(155deg, #2a2a2e, #141416);
    transition: transform 0.6s var(--dp-ease);
  }
  .d-card:hover .d-media {
    transform: scale(1.07);
  }
  .d-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(0deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0) 42%);
  }
  .d-label {
    position: absolute;
    left: 18px;
    bottom: 16px;
    right: 18px;
    z-index: 2;
  }
  .d-label b {
    display: block;
    font-family: var(--dp-font-title);
    font-size: 20px;
    font-weight: 400;
    text-transform: uppercase;
  }
  .d-label span {
    font-size: 12px;
    color: var(--dp-muted);
    text-transform: uppercase;
  }
  .d-tag {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    font-size: 10.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: var(--dp-ink);
    color: var(--dp-paper);
    padding: 4px 9px;
    border-radius: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .row-viewport {
      overflow-x: auto;
    }
    /* No scale-on-hover under reduced motion — the box-shadow lift stays (it's
       not motion), but the card + inner media hold their size. */
    .d-card:hover,
    .d-card:hover .d-media {
      transform: none;
    }
  }
  /* Manual reduced-motion (corner toggle sets html[data-sim-reduced]) — the row
     falls back to native horizontal scroll, mirroring the media-query path. The
     drift rAF + loop clones are torn down in JS on the same signal. */
  :global([data-sim-reduced]) .row-viewport {
    overflow-x: auto;
  }
  :global([data-sim-reduced]) .d-card:hover,
  :global([data-sim-reduced]) .d-card:hover .d-media {
    transform: none;
  }

  /* ===== Mobile: FIFO card queue =====
     A different structure from the desktop drift (src/lib/motion/mobile-queue.ts):
     JS adds `.is-queue` and shows only the FRONT card; the amber chevrons in
     `.queue-nav` rotate the queue (front → back). No track transform is involved,
     so resizing out of the desktop drift can't leave the card misaligned. */
  @media (max-width: 768px) {
    .row-viewport {
      position: relative; /* anchors the .queue-nav control layer */
      padding-block: 0;
      margin-block: 0;
    }
    /* Queue mode is switched on by JS (.is-queue), so the plain server DOM is
       untouched until the queue mounts. */
    .row-viewport.is-queue .row-track {
      display: block;
    }
    .row-viewport.is-queue .d-card {
      display: none;
      width: 100%;
    }
    .row-viewport.is-queue .d-card:first-child {
      display: block; /* the queue front */
    }
    .d-card:hover {
      transform: none; /* touch: no scale */
    }
  }

  /* Chevron controls — their OWN layer over the queue, NOT attached to the card,
     so a resize can never displace them relative to it. JS-created → :global.
     Bare amber chevrons: no box, no background — just the glyph, with a soft
     shadow so it stays legible over light or dark card art. */
  :global(.row-viewport .queue-nav) {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none; /* only the buttons take input */
  }
  :global(.row-viewport .queue-nav__btn) {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    background: none;
    color: var(--dp-accent);
    cursor: pointer;
    pointer-events: auto;
    filter: drop-shadow(0 1px 2px rgba(20, 18, 12, 0.45));
    -webkit-tap-highlight-color: transparent;
  }
  :global(.row-viewport .queue-nav__btn--prev) {
    left: 2px;
  }
  :global(.row-viewport .queue-nav__btn--next) {
    right: 2px;
  }
  :global(.row-viewport .queue-nav__btn svg) {
    display: block;
  }
</style>
